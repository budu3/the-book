<?xml version="1.0" encoding="utf-8"?>
<!-- 
    Home Fragment Layout
    Main movie browsing screen with header, featured image, and movie category lists
-->
<ScrollView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.home.HomeFragment">

    <LinearLayout
        android:id="@+id/home_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_dark"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- App Logo -->
        <ImageView
            android:id="@+id/app_logo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/app_logo_description"
            app:srcCompat="@drawable/myflix_icon" />

        <!-- Featured Movie Banner -->
        <ImageView
            android:id="@+id/featured_banner"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginBottom="24dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/featured_movie_description"
            app:srcCompat="@drawable/main" />

        <!-- Favorites Section -->
        <TextView
            android:id="@+id/favorites_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/favorites_title"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/fav_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginBottom="16dp"
            android:clipToPadding="false"
            android:paddingStart="0dp"
            android:paddingEnd="16dp" />

        <!-- Drama Section -->
        <TextView
            android:id="@+id/drama_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/drama_title"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/drama_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginBottom="16dp"
            android:clipToPadding="false"
            android:paddingStart="0dp"
            android:paddingEnd="16dp" />

        <!-- Comedy Section -->
        <TextView
            android:id="@+id/comedy_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/comedy_title"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/comedy_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginBottom="16dp"
            android:clipToPadding="false"
            android:paddingStart="0dp"
            android:paddingEnd="16dp" />

        <!-- Debug Text Views (Hidden by default) -->
        <TextView
            android:id="@+id/text_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAlignment="center"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="Debug: Home Fragment Data" />

    </LinearLayout>
</ScrollView>